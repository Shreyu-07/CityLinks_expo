{
  "expo": {
    "name": "CityLinks",
    "slug": "citylinks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citylinks.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CityLinks needs your location to show nearby shops.",
        "NSPhotoLibraryUsageDescription": "Allow CityLinks to access your photos to upload profile pictures.",
        "NSCameraUsageDescription": "Allow CityLinks to access your camera to take photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0d2fa3"
      },
      "package": "com.citylinks.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CityLinks needs access to your photos to upload profile pictures.",
          "cameraPermission": "CityLinks needs access to your camera to take photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CityLinks needs your location to show nearby shops."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d738e4d6-739e-4f47-aa56-5570433dfefa"
      }
    }
  }
}
